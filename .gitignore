builders_user/
dev/_builder_keys.json
# Wildcard catalog and your curation of the shipped lists
wildcards/_catalog.sqlite*
wildcards/_catalog_user.yaml

# Wildcard review tool: runtime-generated undo/apply manifests (kept locally, not shipped)
tools/wildcard_review/manifests/
